MUCHI_API_TOKEN=replace-with-a-random-32-byte-secret
GOOGLE_CLOUD_PROJECT=replace-with-your-gcp-project
MUCHI_TASK_REGION=us-central1
MUCHI_TASK_QUEUE=muchi-searches
MUCHI_TASK_URL=https://replace-with-private-task-function-url
MUCHI_TASK_SERVICE_ACCOUNT=replace-with-task-service-account
MUCHI_API_ADDRESS=:8080

# Optional overrides; defaults shown below apply when unset.
# MUCHI_STORES_CONFIG=config/stores.yaml
# MUCHI_WORKER_ID=<hostname>
# MUCHI_LEASE_SECONDS=60
# MUCHI_POLL_SECONDS=2
# MUCHI_SOURCE_TIMEOUT_SECONDS=10
# MUCHI_SOURCE_MAX_ATTEMPTS=3
# MUCHI_SOURCE_RETRY_BASE_MS=250
# MUCHI_SOURCE_MAX_BODY_BYTES=16777216
# MUCHI_SERVER_READ_HEADER_TIMEOUT_SECONDS=5
# MUCHI_SERVER_READ_TIMEOUT_SECONDS=15
# MUCHI_SERVER_WRITE_TIMEOUT_SECONDS=30
# MUCHI_SERVER_IDLE_TIMEOUT_SECONDS=60
# MUCHI_SERVER_SHUTDOWN_TIMEOUT_SECONDS=10
# MUCHI_HEALTH_CHECK_TIMEOUT_SECONDS=2
# MUCHI_STOCK_CHECK_LIMIT=5
# MUCHI_OFFER_CACHE_TTL_SECONDS=259200
# MUCHI_OFFER_CACHE_EMPTY_TTL_SECONDS=120

# Cuanto vive el Inventario publicado que se lee de Moxfield. Una Lista cambia
# cada vez que la Tienda vende o compra, mucho antes que un Resultado de Busqueda.
# MUCHI_INVENTORY_CACHE_TTL_SECONDS=3600
# MUCHI_SEARCH_TTL_SECONDS=86400
# MUCHI_MAX_CARDS_PER_SEARCH=500

# Cuantos Turnos repone un Barrido como maximo. Mas alto, un solo Barrido
# golpearia las Fuentes mas fuerte que cualquier Busqueda.
# MUCHI_SWEEP_MAX_WAKES=50
# MUCHI_MAX_QUANTITY_PER_CARD=99
# MUCHI_SUSPICIOUS_PRICE_PERCENT=30

# Plazo HTTP de cada tarea; mantener alineado con TIMEOUT de config/deploy.env.
# MUCHI_TASK_DEADLINE_SECONDS=1800
