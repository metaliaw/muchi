meta {
  name: Find Card Offers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/cards/offers?name=Sol%20Ring
  body: none
  auth: bearer
}

params:query {
  name: Sol Ring
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Returns Offers", function() {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Sol Ring");
    expect(res.body.offers).to.be.an("array");
  });
}
