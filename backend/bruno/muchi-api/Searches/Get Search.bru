meta {
  name: Get Search
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/searches/{{searchId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Returns Search", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getEnvVar("searchId"));
  });
}
