meta {
  name: List Results
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/searches/{{searchId}}/results
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Returns Results", function() {
    expect(res.status).to.equal(200);
    expect(res.body.search_id).to.equal(bru.getEnvVar("searchId"));
    expect(res.body.items).to.be.an("array");
  });
}
