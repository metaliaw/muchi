meta {
  name: Cancel Search
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/searches/{{searchId}}/cancel
  body: none
  auth: bearer
}

headers {
  Idempotency-Key: {{cancelKey}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Cancels Search", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("cancelled");
  });
}
