meta {
  name: Create Search
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/searches
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{createKey}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "cards": [
      {
        "name": "Sol Ring",
        "quantity": 1
      }
    ],
    "options": {
      "verify_stock": true,
      "stores_only": true
    }
  }
}

script:post-response {
  if (res.status === 202) {
    bru.setEnvVar("searchId", res.body.id);
  }
}

tests {
  test("Queues Search", function() {
    expect(res.status).to.equal(202);
    expect(res.body.status).to.be.oneOf(["queued", "running", "completed"]);
  });
}
