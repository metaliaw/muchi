REGION=southamerica-east1
FIRESTORE_LOCATION=southamerica-east1
RUNTIME=go126
API_NAME=muchi-serve-api
WORKER_NAME=muchi-process-search
TASK_QUEUE=muchi-searches
API_ACCOUNT=muchi-api
WORKER_ACCOUNT=muchi-worker
TASK_ACCOUNT=muchi-tasks
BUILD_ACCOUNT=muchi-build
MUCHI_API_TOKEN=muchi-api-token:latest
MEMORY=512Mi
TIMEOUT=1800s
MAX_INSTANCES=5
DISPATCH_RATE=1
CONCURRENT_TASKS=2
SWEEPER_NAME=muchi-sweep-queue
SWEEPER_JOB=muchi-sweep
# Cada cinco Minutos: lo bastante seguido para que nadie note un Despertar
# perdido, lo bastante espaciado para no encender una Instancia todo el Dia.
SWEEPER_SCHEDULE="*/5 * * * *"

# Los Fronts viven en el repositorio metaliaw/muchi y montan este mismo
# Secreto. Conviven durante la Migración: muchi es Streamlit, muchi-web es Vue.
FRONT_NAMES="muchi muchi-web"

# Identidad del Comprador con la que PlaceOrder hace Checkout en WooCommerce.
# Provisorio: un Correo real de Muchi la debe Reemplazar antes de un Volumen
# serio de Pedidos — ver docs/checkout/agentless-checkout.md.
ORDER_BUYER_NAME="Muchi"
ORDER_BUYER_EMAIL="cangrejometralleta@gmail.com"

ORDER_RELEASE_NAME=muchi-release-orders
ORDER_RELEASE_JOB=muchi-release-orders
# Una vez por Hora: una Orden pending Tiene hasta 24 Horas de Plazo
# (MUCHI_ORDER_PENDING_TTL_SECONDS), así que no Necesita el Ritmo del Barredor.
ORDER_RELEASE_SCHEDULE="0 * * * *"

# Firma HMAC de los Webhooks de Orden que cada Tienda WooCommerce Configura
# a mano en su propio Admin, apuntando a
# /v1/webhooks/woocommerce/{domain}/orders. Vive en Secret Manager, igual que
# MUCHI_API_TOKEN — nunca en texto plano.
ORDER_WEBHOOK_SECRET=muchi-order-webhook-secret:latest
