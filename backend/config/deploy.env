REGION=southamerica-east1
FIRESTORE_LOCATION=southamerica-east1
RUNTIME=go126
API_NAME=muchi-serve-api
WORKER_NAME=muchi-process-search
TASK_QUEUE=muchi-searches
API_ACCOUNT=muchi-api
WORKER_ACCOUNT=muchi-worker
TASK_ACCOUNT=muchi-tasks
BUILD_ACCOUNT=muchi-build
MUCHI_API_TOKEN=muchi-api-token:latest
MEMORY=512Mi
TIMEOUT=1800s
MAX_INSTANCES=5
DISPATCH_RATE=1
CONCURRENT_TASKS=2
SWEEPER_NAME=muchi-sweep-queue
SWEEPER_JOB=muchi-sweep
# Cada cinco Minutos: lo bastante seguido para que nadie note un Despertar
# perdido, lo bastante espaciado para no encender una Instancia todo el Dia.
SWEEPER_SCHEDULE="*/5 * * * *"

# Los Fronts viven en el repositorio metaliaw/muchi y montan este mismo
# Secreto. Conviven durante la Migración: muchi es Streamlit, muchi-web es Vue.
FRONT_NAMES="muchi muchi-web"
