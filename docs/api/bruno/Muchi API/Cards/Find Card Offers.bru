meta {
  name: Find Card Offers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cards/offers?name=Sol Ring&match=exact
  body: none
  auth: inherit
}

params:query {
  name: Sol Ring
  ~match: exact
}

docs {
  Una Carta, sin encolar nada: consulta las Fuentes y responde en la misma
  Llamada. Sirve para probar una Tienda sin esperar a un Worker.

  `match` Elige cuanto Puede Alejarse el Titulo de la Tienda del Nombre
  Pedido. `exact`, el Default, Trae la Carta y sus Impresiones. `includes`
  Trae ademas sus Derivados: Winged Kuriboh, Linkuriboh, Token: Kuriboh.
}

tests {
  test("las Ofertas traen Precio y Moneda", function () {
    expect(res.getStatus()).to.equal(200);
    res.getBody().offers.forEach((offer) => {
      expect(offer.price_amount).to.match(/^[0-9]+(\.[0-9]{1,2})?$/);
      expect(offer.price_currency).to.match(/^[A-Z]{3}$/);
    });
  });
}
