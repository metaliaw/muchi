# Entorno explícito: development o production.
MUCHI_ENV=development

# Servicio obligatorio. URL base con o sin /v1.
# El Código de Seguridad se envía como Bearer, según openapi.yaml.
# Ejemplo de Producción:
# MUCHI_API_URL=https://muchi-serve-api-c2ce6c7oga-rj.a.run.app
#   MUCHI_API_TOKEN=<gcloud secrets versions access latest --secret=muchi-api-token --project=muchi-507614>
MUCHI_API_URL=http://127.0.0.1:8081
MUCHI_API_TOKEN=replace-with-a-random-32-byte-secret

# Apoyo opcional. La donación vive en la columna lateral; el patrocinio,
# al final del contenido, separado de las Ofertas orgánicas.
# MUCHI_DONATION_URL=https://tu-plataforma-de-donaciones.example/muchi
# MUCHI_SPONSOR_NAME=Nombre de la Tienda
# MUCHI_SPONSOR_TEXT=Cartas y accesorios con despacho en Chile.
# MUCHI_SPONSOR_URL=https://tienda.example

# Las Redes viven en el Pie, como Insignias. Una Red sin Dirección no aparece.
# MUCHI_INSTAGRAM_URL=https://instagram.com/muchi
# MUCHI_DISCORD_URL=https://discord.gg/muchi
# MUCHI_X_URL=https://x.com/muchi
# MUCHI_YOUTUBE_URL=https://youtube.com/@muchi
# MUCHI_TIKTOK_URL=https://tiktok.com/@muchi

# AdSense ocupa tres de cada cuatro Búsquedas cuando ambas Opciones existen.
# El Identificador de Cliente tiene el formato ca-pub-0000000000000000.
MUCHI_ADSENSE_CLIENT=ca-pub-6368656861543000
# MUCHI_ADSENSE_SLOT=0000000000
